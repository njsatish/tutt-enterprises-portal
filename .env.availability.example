# HTTPS endpoint returning normalized JSON: {"dates":[...],"slots":[...]}
# Supported placeholders: {businessId}, {staffId}, {serviceId}, {variantId}
BOOKSY_AVAILABILITY_URL_TEMPLATE=https://YOUR-AVAILABILITY-PROVIDER.example/slots?businessId={businessId}&staffId={staffId}&serviceId={serviceId}&variantId={variantId}
# Optional token, sent as Authorization: Bearer <value>
BOOKSY_AVAILABILITY_BEARER_TOKEN=
